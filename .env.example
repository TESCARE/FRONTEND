# Google Sheet sync — the Apps Script web app URL.
# See docs/LEADS_SETUP.md steps 4 and 5. Without it the forms still send
# the notification email, and the Gmail sweep still fills the sheet.
VITE_SHEET_ENDPOINT=

# Optional: point the forms at a different Web3Forms account.
# The live key is already the default in src/leadSubmit.js.
VITE_WEB3FORMS_KEY=
